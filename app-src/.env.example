# Where "Book a demo" submissions are forwarded as JSON (Zapier, Make, n8n, a CRM webhook...).
# If unset, /api/demo-request answers 503 and the form tells people it isn't connected yet.
DEMO_REQUEST_WEBHOOK_URL=

# --- Auth (Phase 3) ---------------------------------------------------------
# Required in production: 16+ random characters used to sign session and OTP cookies.
#   openssl rand -base64 32
AUTH_SECRET=
# How OTP codes are delivered: "whatsapp" or "dev".
# "dev" (the default outside production) prints the code on the server console and shows it on the
# onboarding page. In production with no provider configured, sending a code returns 503.
AUTH_OTP_PROVIDER=
# WhatsApp Cloud API (needs an approved *authentication* template):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANG=en

# --- Database & short links (Phase 4) --------------------------------------
# Postgres connection string. Required in production. Leave empty in development to use the
# embedded database in .data/pglite.
DATABASE_URL=
DATABASE_POOL_MAX=10
# Where short links live. Leave empty to use this app's own /q/<code> path.
# For a short domain: SHORT_LINK_BASE=https://skn.to and SHORT_LINK_HOST=skn.to
SHORT_LINK_BASE=
SHORT_LINK_HOST=
# Where the bare short domain (skn.to/) redirects, e.g. your marketing site.
SITE_URL=

# --- Platform (Phase 8) ------------------------------------------------------
# Skanor staff who may open /app/admin: comma-separated Indian mobile numbers. Empty = nobody.
# Everyone else gets a plain "not found" for the console and its APIs.
ADMIN_PHONES=
# Development only: let webhooks be delivered to http:// and localhost addresses so you can test them on your machine.
# It is ignored when NODE_ENV=production, where private, internal and non-https addresses are always refused.
WEBHOOK_ALLOW_PRIVATE=

# --- File storage (logos, PDFs) ----------------------------------------------
# Public address of this app, used to build links to uploaded files (https://app.skanor.in). Empty = the host of the request.
APP_URL=
# Where uploaded files are kept. With no S3_* settings they are stored in Postgres, which is fine to start with.
# Set all three to use S3-compatible storage (AWS S3, Cloudflare R2, MinIO, Supabase Storage): files are then written
# there, and files stored earlier in Postgres stay readable.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave empty for AWS S3 (then S3_REGION is the bucket's region, e.g. ap-south-1).
# For R2, MinIO or Supabase, set the endpoint, e.g. https://<account>.r2.cloudflarestorage.com; the region defaults to "auto".
S3_REGION=
S3_ENDPOINT=
# With S3_ENDPOINT set the bucket goes in the path. Set 0 to put it in the host name instead.
S3_PATH_STYLE=
